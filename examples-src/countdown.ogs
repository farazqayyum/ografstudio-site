          "loop": null,
          "element": {
            "type": "rectangle",
            "fill": {
              "type": "shader",
              "name": "Sports / Velocity diagonals",
              "fragmentSource": "#pragma ograf ink color\nvec4 ink = vec4(0.05, 0.09, 0.15, 1.0);\n#pragma ograf accent color\nvec4 accent = vec4(0.15, 0.65, 0.85, 1.0);\n#pragma ograf strength slider min(0) max(0.5) step(0.01)\nfloat strength = 0.18;\n#pragma ograf speed slider min(0) max(2) step(0.05)\nfloat speed = 1.0;\n\nvoid mainImage(out vec4 color, in vec2 pixel) {\n  vec2 uv = pixel / iResolution.xy;\n  vec2 p = vec2(uv.x * iResolution.x / iResolution.y, uv.y);\n  float aa = 1.5 / max(1.0, iResolution.y);\n  float t = iTime * speed;\n  float diagonal = p.x * 0.68 + p.y;\n  float lane = abs(fract(diagonal / 0.38 + 0.5) - 0.5) * 0.38;\n  float stripes = 1.0 - smoothstep(0.025, 0.025 + aa, lane);\n  float energy = 0.5 + 0.5 * sin(diagonal * 2.1 - t * 0.58);\n  float motif = stripes * (0.25 + energy * 0.55) + energy * 0.12;\n  // Keep the text area calm and preserve the original panel's subtle alpha falloff.\n  float edge = 0.40 + 0.60 * pow(abs(uv.y - 0.5) * 2.0, 2.0);\n  vec3 surface = ink.rgb * mix(1.06, 0.90, uv.x);\n  float reflectionDistance = abs(uv.x + uv.y * 0.18 - mix(-0.35, 1.35, fract(t / 7.0)));\n  float reflection = pow(max(0.0, 1.0 - reflectionDistance / 0.24), 3.0);\n  surface = mix(surface, vec3(1.0), reflection * strength * 0.32 * edge);\n  float light = clamp(motif * strength * accent.a * edge, 0.0, 0.35);\n  color = vec4(mix(surface, accent.rgb, light), ink.a * mix(0.97, 0.78, uv.x));\n}",
              "speed": 1,
              "resolutionScale": 1,
              "parameters": {
                "ink": [
                  0.07450980392156863,
                  0.13725490196078433,
                  0.16470588235294117,
                  1
                ],
                "accent": [
                  0,
                  0.8980392156862745,
                  1,
                  1
                ],
                "strength": 0.18,
                "speed": 1
              }
            },
            "strokeColor": "#ffffff26",
            "strokeWidth": 1,
            "borderRadius": {
              "topLeft": 6,
              "topRight": 6,
              "bottomRight": 6,
              "bottomLeft": 6
            }
          },
