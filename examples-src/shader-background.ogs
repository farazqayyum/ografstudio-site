          "loop": null,
          "element": {
            "type": "rectangle",
            "fill": {
              "type": "shader",
              "fragmentSource": "// Wave Bands - an OGraf Studio shader fill example.\n//\n// Diagonal streaks of light drifting across a tinted background, with an optional glow. In\n// OGraf Studio the \"#pragma ograf\" lines turn the constants below into controls and operator\n// data fields.\n//\n// Dedicated to the public domain under CC0-1.0.\n\n#pragma ograf speed slider min(0) max(4) step(0.1)\nconst float speed = 1.0;\n#pragma ograf tint color\nconst vec3 tint = vec3(0.14, 0.32, 0.76);\n#pragma ograf glow toggle\nconst bool glow = true;\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  float diagonal = uv.x * 1.6 + uv.y;\n\n  // A deep gradient in the tint colour.\n  vec3 colour = mix(tint * 0.12, tint * 0.75, uv.y * 0.7 + 0.15);\n\n  // Broad, soft streaks and finer bright ones moving at different speeds.\n  float broad = pow(0.5 + 0.5 * sin(diagonal * 9.0 - iTime * speed), 10.0);\n  float fine = pow(0.5 + 0.5 * sin(diagonal * 23.0 - iTime * speed * 1.7 + 1.3), 28.0);\n  colour += tint * broad * 0.9 + vec3(0.85, 0.92, 1.0) * fine * 0.3;\n\n  if (glow) colour += tint * 0.6 * exp(-7.0 * length(uv - vec2(0.75, 0.7)));\n\n  // Darken towards the edges so text over the middle stays readable.\n  colour *= 1.0 - 0.55 * dot(uv - 0.5, uv - 0.5);\n  fragColor = vec4(colour, 1.0);\n}\n",
              "speed": 1,
              "resolutionScale": 1,
              "parameters": {
                "speed": 1,
                "tint": [
                  0.14,
                  0.32,
                  0.76
                ],
                "glow": true
              }
            },
            "strokeColor": "transparent",
            "strokeWidth": 0,
            "borderRadius": {
              "topLeft": 0,
              "topRight": 0,
              "bottomRight": 0,
              "bottomLeft": 0
            }
          },
          "effects": {
            "blur": 0,
            "dropShadowEnabled": false,
            "dropShadowColor": "#000000",
            "dropShadowOpacity": 0.65,
            "dropShadowOffsetX": 8,
            "dropShadowOffsetY": 8,
            "dropShadowBlur": 12
          },
