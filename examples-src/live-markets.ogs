      ],
      "transitions": [
        {
          "id": "transition-64935b29-777f-4b97-be2b-f1d61b35146f",
          "fromKeyframeId": "keyframe-d21e5797-6f06-42ed-a4b3-1b8e4c0b32b5",
          "toKeyframeId": "keyframe-e550c0d0-e911-4fbb-beda-541416ef94e6",
          "durationFrames": 30,
          "easing": "linear"
        },
        {
          "id": "transition-3a2bd020-ac4e-4472-92a1-719dfcf744ff",
          "fromKeyframeId": "keyframe-e550c0d0-e911-4fbb-beda-541416ef94e6",
          "toKeyframeId": "keyframe-6ba83ed3-e64f-4891-89c1-dab64c563bb3",
