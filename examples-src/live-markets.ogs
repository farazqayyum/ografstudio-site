      ],
      "designSystem": {
        "name": "Brand Kit",
        "tokens": []
      },
      "components": [],
      "keyframes": [
        {
          "id": "keyframe-d21e5797-6f06-42ed-a4b3-1b8e4c0b32b5",
          "name": "Start",
          "role": "start"
        },
        {
          "id": "keyframe-e550c0d0-e911-4fbb-beda-541416ef94e6",
