      "transitions": [
        {
          "id": "transition-f27c27c3-4a54-493f-9edf-b4d00bb2762d",
          "fromKeyframeId": "keyframe-169d6398-5031-4c81-abd2-aa55ccf7f4e5",
          "toKeyframeId": "keyframe-944fd79f-2ff1-49cf-9a08-51621b6a088e",
          "durationFrames": 26,
          "easing": "linear"
        },
        {
          "id": "transition-aede62cb-50aa-4e05-9e66-f9dfd05b05a1",
          "fromKeyframeId": "keyframe-944fd79f-2ff1-49cf-9a08-51621b6a088e",
          "toKeyframeId": "keyframe-cecd9db9-299c-4204-9713-def2febc9f9a",
